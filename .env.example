# Copy this file to .env for local overrides. Never commit .env.
RESEARCH_AGENT_LOG_LEVEL=INFO
RESEARCH_AGENT_DATA_DIRECTORY=data
RESEARCH_AGENT_CONCURRENCY__DISCOVERY=3
RESEARCH_AGENT_CONCURRENCY__DOWNLOADS=4
RESEARCH_AGENT_CONCURRENCY__ANALYSIS=2

# Discovery pacing and credentials. The API key is optional; without it the public rate
# limit applies. Never commit a real value.
# RESEARCH_AGENT_SOURCES__OPENALEX_MAILTO=you@example.com
# RESEARCH_AGENT_SOURCES__SEMANTIC_SCHOLAR_API_KEY=redacted


# Inference endpoints. Any OpenAI-compatible server works locally (Ollama, LM Studio,
# llama.cpp server). NVIDIA NIM is optional: without a key, strong work runs locally.
# RESEARCH_AGENT_MODELS__LOCAL__BASE_URL=http://localhost:11434/v1
# RESEARCH_AGENT_MODELS__LOCAL__MODEL=qwen3:8b
# RESEARCH_AGENT_MODELS__NIM__BASE_URL=https://integrate.api.nvidia.com/v1
# RESEARCH_AGENT_MODELS__NIM__MODEL=meta/llama-3.1-70b-instruct
# RESEARCH_AGENT_MODELS__NIM__API_KEY=redacted
